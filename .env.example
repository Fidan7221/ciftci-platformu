# Bu dosyayı kopyalayıp adını ".env" yapın ve değerleri doldurun.
# .env dosyası git'e GÖNDERİLMEZ (.gitignore); .env.example ise şablon olarak gönderilir.
# Gerçek anahtarları ASLA bu dosyaya, koda veya commit mesajına yazmayın.

FLASK_APP=run.py
FLASK_ENV=development

# Uzun ve rastgele bir değer olmalı. Üretmek için terminalde:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=buraya-uzun-rastgele-bir-anahtar-yazin

# Boş bırakılırsa instance/app.db kullanılır
DATABASE_URL=

# --- Harici API'ler (Hafta 9) ------------------------------------------------
# true  : İnternete çıkılmaz; sahte fiyat sağlayıcısı ve test ödeme sağlayıcısı kullanılır (ders ve demo için)
# false : Aşağıdaki gerçek / sandbox adresleri ve anahtarları kullanılır
USE_MOCK_APIS=true

# Hal / piyasa fiyat servisi
PRICE_API_URL=
PRICE_API_KEY=
PRICE_API_TIMEOUT=10
PRICE_API_RATE_LIMIT_PER_MINUTE=30

# Ödeme sağlayıcısı (yalnızca SANDBOX / test anahtarları)
PAYMENT_API_URL=
PAYMENT_API_KEY=
PAYMENT_SECRET_KEY=
PAYMENT_API_TIMEOUT=15

# Bir kullanıcının 10 dakikada en fazla kaç ödeme denemesi yapabileceği
PAYMENT_ATTEMPTS_PER_10_MIN=5

# Ödenmeyen siparişlerin kaç saat sonra iptal edileceği (flask cancel-unpaid)
UNPAID_ORDER_TIMEOUT_HOURS=24
