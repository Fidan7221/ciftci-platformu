# Bu dosyayı kopyalayıp adını ".env" yapın ve değerleri doldurun.
# .env dosyası git'e GÖNDERİLMEZ; .env.example ise şablon olarak gönderilir.

FLASK_APP=run.py
FLASK_ENV=development

# Uzun ve rastgele bir değer olmalı. Üretmek için terminalde:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=buraya-uzun-rastgele-bir-anahtar-yazin

# Boş bırakılırsa instance/app.db kullanılır
DATABASE_URL=

# Hafta 9'da doldurulacak
PRICE_API_URL=
PAYMENT_API_KEY=
PAYMENT_SECRET_KEY=
